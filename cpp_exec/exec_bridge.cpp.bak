// Add after DefaultExecutionClient constructor, around line ~230
void DefaultExecutionClient::setupOrderWebSocket() {
    spdlog::info("Setting up order update WebSocket...");
    
    // First, bootstrap the order cache with existing open orders
    bootstrapOrderCache();
    
    // Subscribe to the account.orderUpdate stream - check if method exists
    try {
        // Check if the Backpack SDK provides a WebSocket API
        // If not available, gracefully degrade to polling and log a warning
        // This is a simplified implementation that assumes subscription will be handled elsewhere
        spdlog::info("WebSocket subscription will be handled by external component");
        ws_connected_.store(false);
        ws_orders_initialized_ = true;
        
        // Start a background thread to periodically refresh the order cache for now
        if (!ws_reconnect_thread_.joinable()) {
            ws_reconnect_thread_ = std::thread([this]() {
                while (running_) {
                    try {
                        bootstrapOrderCache(); // Refresh order cache periodically
                        spdlog::debug("Refreshed order cache (WebSocket fallback)");
                    } catch (const std::exception& e) {
                        spdlog::error("Error refreshing order cache: {}", e.what());
                    }
                    std::this_thread::sleep_for(std::chrono::seconds(30));
                }
            });
            ws_reconnect_thread_.detach();
        }
    } catch (const std::exception& e) {
        spdlog::error("Exception in setupOrderWebSocket: {}", e.what());
        ws_connected_.store(false);
    }
}

void DefaultExecutionClient::bootstrapOrderCache() {
    spdlog::info("Bootstrapping order cache with existing open orders...");
    try {
        // Query all open orders using the META bucket
        json params;
        params["statusFilter"] = "Open"; // Only get open orders
        
        json open_orders = execute_signed_request(RestClass::META, "GET", "/api/v1/orders", "orderQueryAll", params);
        
        if (!open_orders.is_array()) {
            spdlog::warn("Expected array of orders from /api/v1/orders, got: {}", open_orders.dump().substr(0, 100));
            return;
        }
        
        {
            std::lock_guard<std::mutex> lock(order_cache_mutex_);
            order_cache_.clear();
            
            for (const auto& order : open_orders) {
                std::string order_id = order.value("orderId", "");
                if (order_id.empty()) {
                    order_id = order.value("id", "");
                }
                
                if (!order_id.empty()) {
                    order_cache_[order_id] = order;
                    spdlog::debug("Added order {} to cache: {}", order_id, order.dump().substr(0, 100));
                }
            }
            
            spdlog::info("Order cache bootstrapped with {} open orders", order_cache_.size());
        }
    } catch (const std::exception& e) {
        spdlog::error("Failed to bootstrap order cache: {}", e.what());
    }
}

void DefaultExecutionClient::handleOrderUpdate(const json& update) {
    std::string order_id = update.value("orderId", "");
    if (order_id.empty()) {
        order_id = update.value("id", "");
    }
    
    if (order_id.empty()) {
        spdlog::warn("Received order update without orderId: {}", update.dump().substr(0, 100));
        return;
    }
    
    std::string status = update.value("status", "");
    std::string symbol = update.value("symbol", "");
    
    spdlog::info("Order update for {}: status={}, symbol={}", order_id, status, symbol);
    
    std::lock_guard<std::mutex> lock(order_cache_mutex_);
    
    if (status == "New" || status == "PartiallyFilled") {
        // Update the cache with the latest order info
        order_cache_[order_id] = update;
        spdlog::debug("Updated order {} in cache: {}", order_id, update.dump().substr(0, 100));
    } else {
        // Terminal states: FILLED, CANCELED, EXPIRED, REJECTED
        if (order_cache_.find(order_id) != order_cache_.end()) {
            // Process the final state (e.g., for FILLED orders)
            if (status == "Filled") {
                // Extract model_id from metadata if available
                std::string model_id;
                OrderRequest original_order;
                std::optional<double> associated_entry_price;
                
                // Attempt to process fills same as with polling
                process_fill_response(update, original_order, model_id, associated_entry_price);
            }
            
            // Remove from cache since it's in a terminal state
            order_cache_.erase(order_id);
            spdlog::debug("Removed order {} from cache (terminal state: {})", order_id, status);
        }
    }
}

// Modify poll_order_status to use the order cache when available
void DefaultExecutionClient::poll_order_status(
    std::string symbol,
    std::string order_id,
    OrderRequest original_order,
    std::string model_id,
    std::optional<double> associated_entry_price) {
    
    thread_local static std::chrono::steady_clock::time_point next_allowed_poll = std::chrono::steady_clock::now();

    // If WebSocket is initialized, first check the cache
    if (ws_orders_initialized_) {
        // Check if order is in the cache (with lock)
        bool found_in_cache = false;
        bool in_terminal_state = false;
        json cached_order;
        
        {
            std::lock_guard<std::mutex> lock(order_cache_mutex_);
            auto it = order_cache_.find(order_id);
            if (it != order_cache_.end()) {
                found_in_cache = true;
                cached_order = it->second;
                std::string status = cached_order.value("status", "");
                in_terminal_state = (status == "Filled" || status == "Canceled" || 
                                    status == "Expired" || status == "Rejected");
                
                if (in_terminal_state) {
                    // If terminal, process it and remove from cache
                    if (status == "Filled") {
                        process_fill_response(cached_order, original_order, model_id, associated_entry_price);
                    }
                    order_cache_.erase(it);
                    spdlog::info("Order {} final status from cache: {}", order_id, status);
                    return; // Order is already in terminal state, no need to poll
                }
            }
        }
        
        // If found in cache but not terminal yet, wait briefly and let WebSocket handle updates
        if (found_in_cache) {
            spdlog::debug("Order {} found in cache but not terminal yet ({}), waiting for WebSocket updates", 
                        order_id, cached_order.value("status", ""));
            
            // Sleep for a longer time since WebSocket will handle updates
            std::this_thread::sleep_for(std::chrono::seconds(5));
            return; // Let WebSocket handle updates from now on
        }
    }
    
    // Increase polling interval for legacy polling
    const auto LEGACY_POLL_INTERVAL = std::chrono::milliseconds(2000); // 2 seconds instead of 200ms
    
    // Poll until status is Filled or Canceled (legacy approach)
    json params;
    params["symbol"] = symbol;
    params["orderId"] = order_id;

    int poll_attempts = 0;
    const int MAX_POLL_ATTEMPTS = 10; // Limit polling attempts
    
    while (poll_attempts++ < MAX_POLL_ATTEMPTS) {
        // Tactical throttle with increased interval
        auto current_time_poll = std::chrono::steady_clock::now();
        if (current_time_poll < next_allowed_poll) {
            auto wait_duration = next_allowed_poll - current_time_poll;
            uint64_t wait_us = std::chrono::duration_cast<std::chrono::microseconds>(wait_duration).count();
            if (wait_us > 0) {
                 spdlog::debug("Tactical poll delay for order_id {}: sleeping for {} µs", order_id, wait_us);
                 precise_sleep_us(wait_us);
            }
        }
        
        // Set next allowed poll time with increased interval
        next_allowed_poll = std::chrono::steady_clock::now() + LEGACY_POLL_INTERVAL;

        try {
            json response = execute_signed_request(RestClass::ORDER_QUERY, "GET", "/api/v1/order", "orderQuery", params);
            std::string status = response.value("status", "");
            
            // Update the order cache with this response
            if (ws_orders_initialized_) {
                std::lock_guard<std::mutex> lock(order_cache_mutex_);
                order_cache_[order_id] = response;
            }
            
            if (status == "FILLED" || status == "CANCELED") {
                spdlog::info("Order {} status: {}", order_id, status);
                if (status == "FILLED") {
                    process_fill_response(response, original_order, model_id, associated_entry_price);
} // namespace bp