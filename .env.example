# Example .env file
# Copy this to .env and fill in your actual credentials and paths

# Backpack API Credentials (ED25519)
# Store the base64 encoded private key
BACKPACK_API_KEY="YOUR_API_KEY_HERE"
BACKPACK_API_SECRET="YOUR_BASE64_ENCODED_PRIVATE_KEY_HERE"

# Database Connection (PostgreSQL)
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="trading_data"
DB_USER="your_db_user"
DB_PASSWORD="your_db_password"

# WebSocket URL
WS_URL="wss://ws.backpack.exchange/"

# Trading Parameters
SYMBOL="SOL_USDC_PERP" # Default symbol
KLINE_MEMORY_ROWS=5000
ORDER_BOOK_DEPTH=20 # Levels to store/display

# ML Model
MODEL_PATH="ml/models/boosting_model.joblib"
PREDICTION_THRESHOLD=0.60 # Minimum probability to trigger entry

# RL Agent (Optional - if used in strategy)
# RL_AGENT_PATH="rl/models/ppo_agent.zip"

# Sizing Parameters
INITIAL_EQUITY_USD=100.0
MIN_LEVERAGE=10.0
MAX_LEVERAGE=100.0
CONFIDENCE_THRESHOLD=0.55
CONFIDENCE_SCALE=0.45

# Bracket Order Parameters
TP_OFFSET_PCT=0.0006
SL_OFFSET_PCT=0.0004

# Risk Management
MAX_CONSECUTIVE_LOSSES=3
MAX_DRAWDOWN_PCT=0.002 # 0.2%
MAX_NOTIONAL_USD=1000000.0
FEE_BPS=1.5 # Placeholder - should be fetched
LOSS_PENALTY_LAMBDA=3.0 # For RL reward

# Strategy Loop
STRATEGY_INTERVAL_SECONDS=180 # ~3 minutes
MODEL_RELOAD_INTERVAL_SECONDS=3600 # Reload model every hour

# Paths
LOG_FILE="trading_system.log"
CPP_EXEC_MODULE_PATH="strategy/_cpp_exec.so" # Path to compiled C++ module

# Airflow / S3 (if used)
# S3_BUCKET_NAME="your-trading-models-bucket"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1" 