{
    "null_threshold": 0.1,
    "numeric_bounds": {
        "price": {
            "min": 0,
            "max": null
        },
        "quantity": {
            "min": 0,
            "max": null
        },
        "age": {
            "min": 0,
            "max": 150
        }
    },
    "correlation_threshold": 0.95,
    "stationarity_threshold": 0.05,
    "feature_groups": {
        "price_related": {
            "features": ["price", "discount", "total_amount"],
            "rules": {
                "total_amount": "price * (1 - discount)"
            }
        },
        "temporal": {
            "features": ["timestamp", "day_of_week", "month", "year"],
            "format": {
                "timestamp": "datetime64[ns]"
            }
        }
    },
    "alert_thresholds": {
        "missing_data_ratio": 0.2,
        "outlier_zscore": 3.0,
        "variance_threshold": 0.01
    }
} 